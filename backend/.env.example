PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impulse_crm
# Gere segredos diferentes com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Apenas para `npm run seed:dev-admin`; não defina estas variáveis em produção.
DEV_ADMIN_NAME=Administrador local
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
