# Prisma pool defaults are conservative and may be overridden per process.
PRISMA_CONNECTION_LIMIT=8
PRISMA_POOL_TIMEOUT=20
PRISMA_CONNECT_TIMEOUT=10
PRISMA_APPLICATION_NAME=impulse-crm-local

# Background analytics is disabled by default; Pipeline HTTP routes are enabled.
ANALYTICS_JOBS_ENABLED=false
PIPELINE_MODULE_ENABLED=true
