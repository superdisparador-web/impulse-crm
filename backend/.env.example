PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/impulse_crm
# Gere segredos diferentes com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Apenas para `npm run seed:dev-admin`; não defina estas variáveis em produção.
DEV_ADMIN_NAME=Administrador local
DEV_ADMIN_EMAIL=
# Mínimo de 6 caracteres; use apenas em desenvolvimento.
DEV_ADMIN_PASSWORD=

# Embedded Signup oficial da Meta. IDs são numéricos obtidos no painel Meta; nunca commite segredos reais.
META_APP_ID=123456789012345
META_APP_SECRET=
META_CONFIG_ID=987654321098765
META_REDIRECT_URI=https://api.example.com/whatsapp/embedded-signup/callback
META_GRAPH_API_VERSION=v23.0
# Chave aleatória com pelo menos 32 caracteres: openssl rand -base64 48
META_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=https://app.example.com
# Timeout em milissegundos (inteiro positivo).
META_WHATSAPP_TIMEOUT_MS=10000
